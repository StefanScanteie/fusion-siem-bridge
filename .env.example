FUSION_SIEM_INGEST_TOKEN=change-me
FUSION_SIEM_DATA_DIR=data
FUSION_SIEM_HOST=0.0.0.0
FUSION_SIEM_PORT=8080
# Optional hostname Fusion uses in the copied webhook URL (never 0.0.0.0)
# FUSION_SIEM_PUBLIC_HOST=collector.example.com
# One destination: none | splunk | qradar | rapid7 | any
# FUSION_SIEM_DESTINATION=none
# Splunk HEC
# FUSION_SIEM_SPLUNK_HEC_URL=https://splunk.example:8088/services/collector/event
# FUSION_SIEM_SPLUNK_HEC_TOKEN=
# FUSION_SIEM_SPLUNK_INDEX=
# FUSION_SIEM_SPLUNK_SOURCETYPE=fusion_siem:v1
# QRadar TCP syslog LEEF
# FUSION_SIEM_QRADAR_HOST=qradar.example
# FUSION_SIEM_QRADAR_PORT=514
# Rapid7 InsightIDR custom log
# FUSION_SIEM_RAPID7_URL=https://data.logs.insight.rapid7.com/log/custom/...
# FUSION_SIEM_RAPID7_TOKEN=
# Any: generic HTTPS JSON collector
# FUSION_SIEM_FORWARD_URL=https://siem.example/collector
# FUSION_SIEM_FORWARD_TOKEN=
# Backfill
# CLIENT_ID=
# CLIENT_SECRET=
# FUSION_SIEM_CONSOLE_URL=https://ctpx.secureworks.com
